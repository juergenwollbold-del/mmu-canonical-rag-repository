import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d.art3d import Poly3DCollection

T  = np.array([0, 0, 1.5])
B2 = np.array([-1, -1, 0])
B3 = np.array([ 1, -1, 0])
B4 = np.array([ 0,  1, 0])
H  = np.vstack([T,B2,B3,B4])

def faces_from_tet(V):
    return [[V[0],V[1],V[2]],
            [V[0],V[1],V[3]],
            [V[0],V[2],V[3]],
            [V[1],V[2],V[3]]]

def small_tet_at_vertex(V0, others):
    mids = [(V0+v)/2 for v in others]
    return np.vstack([V0,*mids])

Tet_top = small_tet_at_vertex(T,[B2,B3,B4])
Tet_q2  = small_tet_at_vertex(B2,[T,B3,B4])
Tet_q3  = small_tet_at_vertex(B3,[T,B2,B4])
Tet_q4  = small_tet_at_vertex(B4,[T,B2,B3])

# Quark-Schwerpunkte
C2 = Tet_q2.mean(axis=0)
C3 = Tet_q3.mean(axis=0)
C4 = Tet_q4.mean(axis=0)

# Kantenmittelpunkte des Basisdreiecks
M23 = 0.5*(B2+B3)
M34 = 0.5*(B3+B4)
M42 = 0.5*(B4+B2)

hex_pts = np.array([C2,M23,C3,M34,C4,M42])

fig = plt.figure(figsize=(7,7))
ax = fig.add_subplot(111, projection="3d")

for V,c in zip([Tet_top,Tet_q2,Tet_q3,Tet_q4],
               ["purple","red","green","blue"]):
    ax.add_collection3d(Poly3DCollection(faces_from_tet(V),
                         facecolor=c,edgecolor=c,alpha=0.3))

for i in range(6):
    p1,p2 = hex_pts[i], hex_pts[(i+1)%6]
    ax.plot(*zip(p1,p2), color="black", linewidth=2)

ax.scatter(hex_pts[:,0],hex_pts[:,1],hex_pts[:,2],
           color="yellow", s=60)

ax.set_xlabel("w2"); ax.set_ylabel("w3"); ax.set_zlabel("w4")
ax.set_title("Chair Proton ")
ax.set_box_aspect([1,1,1])
plt.tight_layout(); plt.show()
